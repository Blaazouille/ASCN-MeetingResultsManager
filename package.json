{
  "name": "ascn-meeting-results",
  "private": true,
  "version": "0.1.0",
  "description": "Application desktop de gestion des classements par équipes pour le Meeting de la Mer (AS Cherbourg Natation).",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.4.0",
    "@tanstack/react-table": "^8.10.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "exceljs": "^3.4.0",
    "lucide-react": "^0.300.0",
    "papaparse": "^5.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.0",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
